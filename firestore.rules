rules_version = '2';

// ALL4PAWS security rules.
// Team: anyone whose verified email is listed in config/admins. Each has a role in config/admins.roles:
//   admin (the default): everything. staff: day-to-day work only, no settings, team list, payments or contact form.
// Customers: signed in, and linked to one record in /clients through its uid field. They can only read and write
// their own record, dogs, bookings and messages, within the limits below.
// Everyone: can read the business settings (services, prices, opening rules) and /busy, which holds each booking's
// dates and size but no names, dogs or addresses, so the booking page can check availability.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // A confirmed email: verified by Firebase, or vouched for by Google at sign-in
    function verified() {
      return signedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    // Staff are recognised by their account (staffUids, added the first time they sign in with a confirmed
    // email or Google) or by a confirmed email on the list (emails)
    function teamDoc() { return get(/databases/$(database)/documents/config/admins).data; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && (request.auth.uid in teamDoc().get('staffUids', {}).keys()
            || (verified() && myEmail() in teamDoc().emails));
    }
    // The team member's email as the team list knows it, and whether they are an admin (the default role)
    function teamEmail() {
      return request.auth.uid in teamDoc().get('staffUids', {}).keys() ? teamDoc().staffUids[request.auth.uid] : myEmail();
    }
    function isOwner() { return isAdmin() && teamDoc().get('roles', {}).get(teamEmail(), 'admin') == 'admin'; }
    // The signed-in person owns the customer record with this id
    function ownsClient(cid) {
      return signedIn() && cid is string
        && get(/databases/$(database)/documents/clients/$(cid)).data.get('uid', '') == request.auth.uid;
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /config/main {
      allow read: if true;
      allow write: if isOwner();
    }

    match /config/admins {
      allow read: if signedIn() && (request.auth.uid in resource.data.get('staffUids', {}).keys()
        || (verified() && myEmail() in resource.data.emails));
      allow write: if isOwner();
      // A listed team member records their own account the first time they sign in (nothing else)
      allow update: if verified() && myEmail() in resource.data.emails
        && changes().hasOnly(['staffUids'])
        && request.resource.data.staffUids.diff(resource.data.get('staffUids', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.staffUids[request.auth.uid] == myEmail();
    }

    // Contact page: anyone can send a message; only admins can read or manage them
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'at', 'status'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120 && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new';
      allow read, update, delete: if isOwner();
    }

    // Meet & Greets: anyone can book one; the team manages them
    match /meetings/{id} {
      allow create: if request.resource.data.keys().hasOnly(['date', 'start', 'end', 'name', 'dogName', 'email', 'phone', 'address', 'notes', 'status', 'at'])
        && request.resource.data.status == 'booked'
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.start is string && request.resource.data.start.matches('[0-9]{2}:[0-9]{2}')
        && request.resource.data.end is string && request.resource.data.end.matches('[0-9]{2}:[0-9]{2}')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() <= 160
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
    // Booked Meet & Greet times with no names, so the booking page can hide taken slots
    match /meetbusy/{id} {
      allow read: if true;
      allow create: if exists(/databases/$(database)/documents/meetings/$(id))
        && request.resource.data.keys().hasOnly(['date', 'start', 'end'])
        && request.resource.data.date == get(/databases/$(database)/documents/meetings/$(id)).data.date
        && request.resource.data.start == get(/databases/$(database)/documents/meetings/$(id)).data.start;
      allow update, delete: if isAdmin();
    }
    // The connected Google Calendar and sign-in states: server only
    match /google/{id} { allow read, write: if false; }

    match /busy/{id} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        ownsClient(get(/databases/$(database)/documents/bookings/$(id)).data.clientId)
        && request.resource.data.keys().hasOnly(['date', 'endDate', 'cat', 'slot', 'serviceId', 'status', 'petCount'])
      );
      allow delete: if isAdmin();
    }

    match /clients/{cid} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid)
        || (verified() && resource.data.get('email', '') == myEmail());

      // New customer sets up their own record: no prices, not yet approved
      allow create: if isAdmin() || (
        verified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.approved == false
        && request.resource.data.prices.size() == 0
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'address', 'notes', 'approved', 'prices', 'source', 'createdAt'])
      );

      allow update: if isAdmin()
        // Existing customer links their account the first time they sign in with the email Nicole has for them
        || (verified()
            && resource.data.get('uid', null) == null
            && resource.data.get('email', '') == myEmail()
            && changes().hasOnly(['uid'])
            && request.resource.data.uid == request.auth.uid)
        // Customers can update their own contact details, nothing else (not prices, approval or notes)
        || (signedIn()
            && resource.data.get('uid', '') == request.auth.uid
            && changes().hasOnly(['name', 'phone', 'address']));

      allow delete: if isAdmin();
    }

    match /pets/{id} {
      allow read: if isAdmin() || ownsClient(resource.data.clientId);
      allow create: if isAdmin() || ownsClient(request.resource.data.clientId);
      allow update: if isAdmin() || (
        ownsClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
      );
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if isAdmin() || ownsClient(resource.data.clientId);
      // Customers can request bookings for themselves; they can't mark anything paid or completed
      allow create: if isAdmin() || (
        ownsClient(request.resource.data.clientId)
        && request.resource.data.status in ['requested', 'confirmed']
        && request.resource.data.get('paid', false) == false
        && request.resource.data.get('depositPaid', 0) == 0
      );
      // Customers can only cancel their own booking
      allow update: if isAdmin() || (
        ownsClient(resource.data.clientId)
        && changes().hasOnly(['status'])
        && request.resource.data.status == 'cancelled'
      );
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAdmin() || ownsClient(resource.data.clientId);
      allow create: if isAdmin() || (
        ownsClient(request.resource.data.clientId)
        && request.resource.data.from == 'client'
      );
      // Customers can only mark the team's messages as read
      allow update: if isAdmin() || (
        ownsClient(resource.data.clientId)
        && changes().hasOnly(['readByClient'])
      );
      allow delete: if isAdmin();
    }

    // Back office only
    match /updates/{id} { allow read, write: if isAdmin(); }
    match /days/{id} { allow read, write: if isAdmin(); }
    // Card payments are written only by the payment server.
    match /payments/{id} { allow read: if isOwner(); allow write: if false; }
    match /checkouts/{id} { allow read: if isOwner(); allow write: if false; }
    // The connected Stripe account and sign-in states: server only.
    match /stripe/{id} { allow read, write: if false; }

    // Anything else: no access
    match /{document=**} { allow read, write: if false; }
  }
}
