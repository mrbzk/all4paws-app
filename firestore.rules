rules_version = '2';
// TESTING ONLY. Anyone with the link can read and write until the date below.
// Do not enter real customer details until phase 2 (logins) replaces these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 7);
    }
  }
}
