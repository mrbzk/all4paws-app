rules_version = '2';
// TESTING ONLY, same as firestore.rules. Photos up to 5 MB, images only.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{file} {
      allow read: if request.time < timestamp.date(2026, 12, 7);
      allow write: if request.time < timestamp.date(2026, 12, 7)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
